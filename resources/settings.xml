<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="script.homeassistant">
        <category id="connection" label="30010">
            <group id="1">
                <setting id="url" type="string" label="30011" help="30013">
                    <level>0</level>
                    <default>http://homeassistant.local:8123</default>
                    <control type="edit" format="string">
                        <heading>30011</heading>
                    </control>
                </setting>
                <setting id="verify_ssl" type="boolean" label="30012" help="30014">
                    <level>2</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="2" label="30020">
                <setting id="username" type="string" label="30021">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30021</heading>
                    </control>
                </setting>
                <setting id="password" type="string" label="30022" help="30026">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30022</heading>
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="token" type="string" label="30023" help="30024">
                    <level>1</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30023</heading>
                    </control>
                </setting>
                <setting id="test" type="action" label="30025">
                    <level>0</level>
                    <data>RunScript(script.homeassistant,action=test)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>
        <category id="dashboard" label="30030">
            <group id="1">
                <setting id="show_favourites" type="boolean" label="30031">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="show_summaries" type="boolean" label="30032">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="show_areas" type="boolean" label="30033">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="hide_empty_areas" type="boolean" label="30034">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="camera_refresh" type="integer" label="30035" help="30036">
                    <level>0</level>
                    <default>10</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                        <formatlabel>14045</formatlabel>
                    </control>
                </setting>
                <setting id="confirm_off" type="boolean" label="30037" help="30038">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="confirm_open" type="boolean" label="30041" help="30042">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="confirm_off_lights" type="boolean" label="30039" help="30040">
                    <level>0</level>
                    <default>true</default>
                    <dependencies>
                        <dependency type="enable" setting="confirm_off" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
