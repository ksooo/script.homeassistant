<?xml version="1.0" encoding="UTF-8"?>
<window>
    <!-- Home Assistant's dialog transition: in from four fifths of the size
         over 200 ms, and back out the same way. -->
    <animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="zoom" start="80" end="100" center="960,540" time="200" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200" tween="cubic" easing="in">WindowClose</animation>
    <animation effect="zoom" start="100" end="80" center="960,540" time="200" tween="cubic" easing="in">WindowClose</animation>
    <defaultcontrol>110</defaultcontrol>
    <controls>
        <control type="image">
            <left>510</left><top>360</top><width>900</width><height>390</height>
            <texture border="24">panel.png</texture>
        </control>

        <control type="label" id="100">
            <left>570</left><top>402</top><width>660</width><height>33</height>
            <font>font10</font><textcolor>FFA0A0A0</textcolor><label></label>
        </control>
        <control type="label" id="101">
            <left>570</left><top>435</top><width>660</width><height>54</height>
            <scroll>true</scroll><font>font14</font>
            <textcolor>FFF0F0F0</textcolor><label></label>
        </control>
        <!-- The colour as it stands, at full brightness. -->
        <control type="image">
            <left>1266</left><top>411</top><width>84</width><height>84</height>
            <aspectratio>keep</aspectratio>
            <colordiffuse>$INFO[Window.Property(colour)]</colordiffuse>
            <texture>circle.png</texture>
        </control>

        <!-- Neither slider draws a track of its own; the tracks lie
             underneath. -->
        <control type="label" id="102">
            <left>570</left><top>519</top><width>500</width><height>36</height>
            <font>font12</font><textcolor>FFA0A0A0</textcolor><label></label>
        </control>
        <control type="label" id="103">
            <left>1150</left><top>519</top><width>200</width><height>36</height>
            <align>right</align><font>font12</font>
            <textcolor>FFF0F0F0</textcolor><label></label>
        </control>
        <control type="image">
            <left>570</left><top>576</top><width>780</width><height>18</height>
            <texture>hue.png</texture>
        </control>
        <control type="slider" id="110">
            <left>570</left><top>555</top><width>780</width><height>60</height>
            <ondown>111</ondown>
            <texturesliderbar>slider_clear.png</texturesliderbar>
            <textureslidernib colordiffuse="FFB8C2CC">slider_nib.png</textureslidernib>
            <textureslidernibfocus colordiffuse="FF41BDF5">slider_nib.png</textureslidernibfocus>
        </control>

        <control type="label" id="104">
            <left>570</left><top>627</top><width>500</width><height>36</height>
            <font>font12</font><textcolor>FFA0A0A0</textcolor><label></label>
        </control>
        <control type="label" id="105">
            <left>1150</left><top>627</top><width>200</width><height>36</height>
            <align>right</align><font>font12</font>
            <textcolor>FFF0F0F0</textcolor><label></label>
        </control>
        <!-- White shading into the hue: a ramp of the hue over a white bar. -->
        <control type="image">
            <left>570</left><top>684</top><width>780</width><height>18</height>
            <texture>bar.png</texture>
        </control>
        <control type="image">
            <left>570</left><top>684</top><width>780</width><height>18</height>
            <colordiffuse>$INFO[Window.Property(hue)]</colordiffuse>
            <texture>ramp.png</texture>
        </control>
        <control type="slider" id="111">
            <left>570</left><top>663</top><width>780</width><height>60</height>
            <onup>110</onup>
            <texturesliderbar>slider_clear.png</texturesliderbar>
            <textureslidernib colordiffuse="FFB8C2CC">slider_nib.png</textureslidernib>
            <textureslidernibfocus colordiffuse="FF41BDF5">slider_nib.png</textureslidernibfocus>
        </control>
    </controls>
</window>
